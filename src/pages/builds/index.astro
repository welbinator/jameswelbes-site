---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const projects = [
  {
    slug: 'cash-ops',
    title: 'Cash Ops',
    tagline: 'Replaced unreadable cash-order spreadsheets with clean, human-readable reports. Upload the file, get a report in seconds.',
    tags: ['Internal Tool', 'Web App', 'AI-Assisted'],
    tech: ['Vanilla JS', 'SheetJS', 'Cloudflare Workers'],
    img: '/img/built/cashops-mockup.png',
    status: 'Live',
    date: '2026',
  },
  {
    slug: 'forty-percent-myth',
    title: 'The 40% Myth',
    tagline: 'Hyperlocal research project investigating how many real local businesses actually use WordPress. City by city, raw data, no spin.',
    tags: ['Research', 'Web App', 'AI-Assisted'],
    tech: ['Cloudflare Workers', 'D1', 'Vanilla JS'],
    img: '/img/built/40pm-mockup.png',
    status: 'Live',
    date: '2026',
  },
  {
    slug: 'parchment',
    title: 'Parchment',
    tagline: 'A fast, minimal notebook with a full REST API. Write notes. Build scripts. Let your agents read and write alongside you.',
    tags: ['SaaS', 'Web App', 'AI-Assisted'],
    tech: ['React', 'TypeScript', 'Supabase', 'Hetzner'],
    img: '/img/built/parchment-mockup.png',
    status: 'Live',
    date: '2026',
  },
];

const allTags = [...new Set(projects.flatMap(p => p.tags))];
---

<Layout
  title="Things I've Built | James Welbes"
  description="Real tools and products built by James Welbes using AI agents. Case studies with the full story of what was built and why."
>
  <Header />

  <main class="built-wrap">
    <div class="wrap">
      <header class="built-head stagger">
        <div class="eyebrow rise">Built with AI</div>
        <h1 class="rise">Things I've actually shipped</h1>
        <p class="lead rise">Not demos. Not prototypes. Real tools solving real problems, built with AI as the engine and human judgment at the wheel. Each one has a full case study behind it.</p>
      </header>

      <div class="filter-bar rise stagger" id="filter-bar">
        <button class="pill active" data-tag="all">All</button>
        {allTags.map(tag => (
          <button class="pill" data-tag={tag}>{tag}</button>
        ))}
      </div>

      <ul class="project-grid stagger" id="project-grid">
        {projects.map(p => (
          <li class="project-card rise" data-tags={p.tags.join(',')}>
            <a href={`${base}/builds/${p.slug}`}>
              <div class="card-img-wrap">
                <img src={base + p.img} alt={p.title + ' screenshot'} loading="lazy" decoding="async" />
              </div>
              <div class="card-body">
                <div class="card-meta">
                  <span>{p.tags[0]}</span>
                  <span class="dot">·</span>
                  <span>{p.tags[1]}</span>
                  <span class="dot">·</span>
                  <span>{p.date}</span>
                </div>
                <h2>{p.title}</h2>
                <p>{p.tagline}</p>
                <div class="card-tech">
                  {p.tech.map(t => <span class="tech-chip">{t}</span>)}
                </div>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </main>

  <footer class="site-foot">
    <div class="wrap">
      <span>© {new Date().getFullYear()} James Welbes</span>
      <a href={base + '/'}>Home</a>
    </div>
  </footer>
</Layout>

<style>
  .built-wrap { padding: 72px 0 96px; min-height: 70vh; }
  .built-head { max-width: 760px; margin: 0 0 48px; }
  .eyebrow { font-family: var(--font-display); font-size: 13px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: #8fa4ff; margin-bottom: 14px; }
  .built-head h1 { font-size: clamp(32px, 5.5vw, 52px); line-height: 1.06; margin-bottom: 16px; }
  .built-head .lead { font-size: 18px; color: var(--mut); line-height: 1.6; }

  /* Filter bar */
  .filter-bar { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 40px; }
  .pill { background: transparent; border: 1px solid var(--line2); color: var(--mut); font-family: var(--font-body); font-size: 13px; font-weight: 500; padding: 6px 14px; border-radius: 999px; cursor: pointer; transition: background .15s, color .15s, border-color .15s; }
  .pill:hover { border-color: var(--accent); color: var(--txt); }
  .pill.active { background: var(--accent); border-color: var(--accent); color: #fff; }

  /* Grid */
  .project-grid { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 24px; }

  /* Card */
  .project-card a {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background: var(--card);
    border: 1px solid var(--line2);
    border-radius: 14px;
    overflow: hidden;
    height: 100%;
    transition: border-color .2s, transform .2s;
  }
  .project-card a:hover { border-color: var(--accent); transform: translateY(-3px); }

  /* Screenshot */
  .card-img-wrap { aspect-ratio: 16/9; overflow: hidden; background: var(--bg2); }
  .card-img-wrap img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }

  /* Body */
  .card-body { padding: 22px 24px 26px; display: flex; flex-direction: column; gap: 10px; flex: 1; }

  /* Meta row: plain text labels */
  .card-meta { display: flex; align-items: center; gap: 6px; font-size: 13px; color: var(--mut); font-weight: 500; flex-wrap: wrap; }
  .card-meta .dot { color: var(--line2); }

  /* Title */
  .card-body h2 { font-size: 22px; font-weight: 700; line-height: 1.2; color: var(--txt); margin: 0; }

  /* Description */
  .card-body p { font-size: 15px; color: var(--mut); line-height: 1.6; flex: 1; margin: 0; }

  /* Tech chips */
  .card-tech { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }
  .tech-chip {
    font-size: 12px;
    color: #8fa4ff;
    border: 1px solid rgba(143,164,255,.25);
    border-radius: 6px;
    padding: 3px 9px;
    font-weight: 500;
  }

  .project-card.hidden { display: none; }

  .site-foot { border-top: 1px solid var(--line2); padding: 28px 0; }
  .site-foot .wrap { display: flex; align-items: center; justify-content: space-between; color: var(--mut); font-size: 14px; }
  .site-foot a { text-decoration: none; color: var(--mut); }
  .site-foot a:hover { color: var(--txt); }

  @media(max-width: 720px) {
    .built-wrap { padding: 48px 0 72px; }
    .project-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  document.documentElement.classList.add('js');

  const risers = Array.from(document.querySelectorAll('.rise'));
  const io = new IntersectionObserver((es) => es.forEach(e => {
    if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
  }), { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
  risers.forEach((el, i) => { el.style.setProperty('--rd', (i % 6 * 0.05) + 's'); io.observe(el); });
  setTimeout(() => risers.forEach(el => el.classList.add('in')), 2500);

  const pills = document.querySelectorAll('.pill');
  const cards = document.querySelectorAll('.project-card');
  pills.forEach(pill => {
    pill.addEventListener('click', () => {
      pills.forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      const tag = pill.dataset.tag;
      cards.forEach(card => {
        const tags = card.dataset.tags.split(',');
        card.classList.toggle('hidden', tag !== 'all' && !tags.includes(tag));
      });
    });
  });
</script>
